#!/bin/sh /etc/rc.common
# OpenWrt procd init service for the PLC multiplexer.
# Install as /etc/init.d/plc-mux ; enable to run on boot.
# Builds the data plane (mux-setup.sh) then runs the UDP selector daemon under
# procd. Daemon stdout/stderr go to the system log (view with: logread -e plc-mux).
START=99
STOP=10
USE_PROCD=1

DIR=/root/plc-mux

start_service() {
    # Build/refresh the data plane (idempotent). Default selection = PLC #1.
    /bin/sh "$DIR/mux-setup.sh"

    procd_open_instance plc-mux
    procd_set_param command /usr/bin/perl "$DIR/plc-mux.pl"
    procd_set_param respawn          # restart the daemon if it dies
    procd_set_param stdout 1         # -> logread
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd stops the daemon; leave the data plane in place.
    :
}
